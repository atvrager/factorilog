#!/usr/bin/env bash
# pre-commit - ASD-STE100 prose lint and Bazel lint tests.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

if [ "${STE_LINT_DISABLE:-0}" = "1" ]; then
    exit 0
fi

if ! python3 tools/ste-lint.py --diff; then
    echo "pre-commit: fix the prose findings above, or set STE_LINT_DISABLE=1" >&2
    exit 1
fi

if [ "${FAST_COMMIT:-0}" = "1" ]; then
    exit 0
fi

if ! bazel test //tools:ruff_test //tools:ty_test //tools:ste_lint_test //tools:check_flow_tcl_test; then
    echo "pre-commit: fix the test findings above, or set FAST_COMMIT=1" >&2
    exit 1
fi
