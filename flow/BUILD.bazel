# Flow scripts and OpenROAD automation.
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//flow:openroad.bzl", "factorilog_blueprint", "factorilog_science_factory", "factorilog_synth", "openroad_stage")

package(default_visibility = ["//visibility:public"])

exports_files([
    "1_floorplan.tcl",
    "2_place.tcl",
    "3_route.tcl",
    "4_sta.tcl",
    "factorilog.tcl",
    "orfs.sh",
    "verify_def.tcl",
])

filegroup(
    name = "flow_scripts",
    srcs = glob([
        "*.tcl",
        "*.sh",
    ]),
)

py_library(
    name = "check_blueprint_lib",
    srcs = ["check_blueprint.py"],
)

py_binary(
    name = "check_blueprint",
    srcs = ["check_blueprint.py"],
    main = "check_blueprint.py",
)

py_library(
    name = "analyze_telemetry_lib",
    srcs = ["analyze_telemetry.py"],
)

py_binary(
    name = "analyze_telemetry",
    srcs = ["analyze_telemetry.py"],
    main = "analyze_telemetry.py",
)

py_library(
    name = "benchmark_factory_lib",
    srcs = ["benchmark_factory.py"],
    deps = [
        ":analyze_telemetry_lib",
        "//foundry:pdk_lib",
    ],
)

py_binary(
    name = "benchmark_factory",
    srcs = ["benchmark_factory.py"],
    main = "benchmark_factory.py",
    deps = [
        ":analyze_telemetry_lib",
        "//foundry:pdk_lib",
    ],
)

py_library(
    name = "test_factory_lib",
    srcs = ["test_factory.py"],
)

py_binary(
    name = "test_factory",
    srcs = ["test_factory.py"],
    main = "test_factory.py",
)

# 1. Synthesis Stage: dump fixture -> Verilog, LEF, Liberty, JSON
factorilog_synth(
    name = "synth",
    cells_v = "cells.v",
    demand = "automation-science-pack 60.0",
    dump = "//test:data/dump-fixture.json",
    enable_circuit_readouts = False,
    enable_display_readouts = False,
    netlist_json = "netlist.json",
    netlist_v = "netlist.v",
    tech_lef = "tech.lef",
    tech_lib = "tech.lib",
    telemetry_taps = "none",
)

# 2. Floorplan Stage: netlist + LEF + Lib -> 1_floorplan.odb
openroad_stage(
    name = "floorplan",
    outs = ["1_floorplan.odb"],
    script = "1_floorplan.tcl",
    srcs = [
        ":netlist.v",
        ":tech.lef",
        ":tech.lib",
    ],
    tags = ["manual"],
)

# 3. Placement Stage: 1_floorplan.odb -> 2_placed.odb
openroad_stage(
    name = "place",
    outs = ["2_placed.odb"],
    script = "2_place.tcl",
    srcs = [
        ":1_floorplan.odb",
    ],
    tags = ["manual"],
)

# 4. Routing Stage: 2_placed.odb -> 3_routed.odb, factory.def, route_drc.rpt
openroad_stage(
    name = "route",
    outs = [
        "3_routed.odb",
        "factory.def",
        "route_drc.rpt",
    ],
    script = "3_route.tcl",
    srcs = [
        ":2_placed.odb",
    ],
    tags = ["manual"],
)

# 5. Timing Analysis Stage: 3_routed.odb + tech.lib -> timing.rpt
openroad_stage(
    name = "sta",
    outs = ["timing.rpt"],
    script = "4_sta.tcl",
    srcs = [
        ":3_routed.odb",
        ":tech.lib",
    ],
    tags = ["manual"],
)

# 6. Blueprint Stage: factory.def + netlist.json -> factory.blueprint
factorilog_blueprint(
    name = "blueprint",
    blueprint = "factory.blueprint",
    def_file = ":factory.def",
    label_text = "red_science_60spm_v2",
    netlist_json = ":netlist.json",
    pins_json = "pins.json",
    tags = ["manual"],
)

# -----------------------------------------------------------------------------
# Science Pack Factory Targets (60 SPM)
# -----------------------------------------------------------------------------

factorilog_science_factory(
    name = "automation_science",
    block_fill = "0.05",
    cell_pad_sites = 4,
    core_margin = 8,
    demand = "automation-science-pack 60.0",
    density = "0.15",
    routability_driven = True,
    use_row_placement = True,
    test_min_active_ratio = "0.60",
    test_ticks = 10800,
    tags = [
        "manual",
        "science",
        "automation_science",
    ],
)

factorilog_science_factory(
    name = "logistic_science",
    block_fill = "0.01",
    cell_pad_sites = 4,
    core_margin = 8,
    demand = "logistic-science-pack 60.0",
    density = "0.02",
    layer_adjustment = "0.5",
    routability_driven = True,
    use_row_placement = True,
    synthesize_splitters = True,
    test_expected_item = "logistic-science-pack",
    test_min_active_ratio = "0.50",
    test_ticks = 45000,
    tags = [
        "manual",
        "science",
        "logistic_science",
    ],
)

factorilog_science_factory(
    name = "military_science",
    block_fill = "0.05",
    cell_pad_sites = 8,
    core_margin = 6,
    demand = "military-science-pack 60.0",
    density = "0.08",
    tags = [
        "manual",
        "science",
        "military_science",
    ],
)

factorilog_science_factory(
    name = "chemical_science",
    block_fill = "0.05",
    cell_pad_sites = 7,
    core_margin = 6,
    demand = "chemical-science-pack 60.0",
    density = "0.08",
    tags = [
        "manual",
        "science",
        "chemical_science",
    ],
)

filegroup(
    name = "science",
    srcs = [
        ":automation_science",
        ":chemical_science",
        ":logistic_science",
        ":military_science",
    ],
    tags = [
        "manual",
        "science",
    ],
)
