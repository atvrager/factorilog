# Dev tooling: the ASD-STE100 prose linter, its rule regression tests, and
# the Python lint and type checks.
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "render_blueprint.js",
    "requirements_lock.txt",
    "requirements.in",
])

filegroup(
    name = "py_srcs",
    srcs = glob(["*.py"]),
)

py_binary(
    name = "ste_lint",
    srcs = ["ste-lint.py"],
    main = "ste-lint.py",
)

py_binary(
    name = "debug_drc",
    srcs = ["debug_drc.py"],
    main = "debug_drc.py",
    deps = [
        "//foundry:pdk_lib",
    ],
)

py_binary(
    name = "inspect_def",
    srcs = ["inspect_def.py"],
    main = "inspect_def.py",
    deps = [
        "//foundry:pdk_lib",
    ],
)

py_binary(
    name = "inspect_bp",
    srcs = ["inspect_bp.py"],
    main = "inspect_bp.py",
    deps = [
        "//foundry:pdk_lib",
    ],
)

py_test(
    name = "inspect_def_test",
    size = "small",
    srcs = [
        "inspect_def.py",
        "test_inspect_def.py",
    ],
    main = "test_inspect_def.py",
    deps = [
        "//foundry:pdk_lib",
    ],
)

py_test(
    name = "ste_lint_test",
    size = "small",
    srcs = [
        "ste-lint.py",
        "test-ste-lint.py",
    ],
    main = "test-ste-lint.py",
)

py_test(
    name = "check_flow_tcl_test",
    size = "small",
    srcs = [
        "check_flow_tcl.py",
        "test_check_flow_tcl.py",
    ],
    data = [
        "//flow:flow_scripts",
    ],
    main = "test_check_flow_tcl.py",
)

sh_test(
    name = "ruff_test",
    size = "small",
    srcs = ["run_ruff.sh"],
    args = [
        "$(location @ruff//:bin)",
        "$(location //:ruff.toml)",
    ],
    data = [
        "@ruff//:bin",
        "//:ruff.toml",
        "//foundry:py_srcs",
        "//reference:py_srcs",
        "//tools:py_srcs",
    ],
)

sh_binary(
    name = "ruff_format",
    srcs = ["format_ruff.sh"],
    args = [
        "$(location @ruff//:bin)",
        "$(location //:ruff.toml)",
    ],
    data = [
        "@ruff//:bin",
        "//:ruff.toml",
        "//foundry:py_srcs",
        "//reference:py_srcs",
        "//tools:py_srcs",
    ],
)

sh_test(
    name = "ty_test",
    size = "small",
    srcs = ["run_ty.sh"],
    args = [
        "$(location @ty//:bin)",
    ],
    data = [
        "@ty//:bin",
        "//:pyproject.toml",
        "//foundry:py_srcs",
        "//tools:py_srcs",
    ],
)
