module(
    name = "factorilog",
    version = "0.1.0",
)

# Python hosts the PDK core: solver, placer, router, blueprint emission.
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_shell", version = "0.7.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.11",
    requirements_lock = "//tools:requirements_lock.txt",
)
use_repo(pip, "pip")

# ruff and ty, pinned static binaries.
lint_tools = use_extension("//rules:lint_tools.bzl", "lint_tools")
use_repo(lint_tools, "ruff", "ty")
