# Hermetic test data: a shrunk prototype dump, generated by
# tools/make_fixture.py from a real `factorio --dump-data` run.
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "fixture",
    srcs = ["data/dump-fixture.json"],
)

filegroup(
    name = "py_srcs",
    srcs = glob(["*.py"]),
)

exports_files(["data/dump-fixture.json"])

load("@rules_python//python:defs.bzl", "py_test")

py_test(
    name = "e2e_test",
    size = "large",
    srcs = ["test_e2e.py"],
    args = ["$(location //flow:factory.blueprint)"],
    data = [
        "//flow:factory.blueprint",
        "//flow:flow_scripts",
        "//foundry:py_srcs",
        "//test:fixture",
    ],
    local = True,
    main = "test_e2e.py",
    tags = [
        "local",
        "manual",
        "requires-game-data",
    ],
    deps = [
        "//flow:check_blueprint_lib",
        "//foundry:pdk_lib",
    ],
)

