# Foundry PDK core. Synthesis (solver) in Python; place-and-route stays in
# OpenROAD. The reference/ scripts are prior art, not part of the build.
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# Python sources, for the workspace-wide lint and type checks.
filegroup(
    name = "py_srcs",
    srcs = glob([
        "*.py",
        "untangle/*.py",
    ]),
)

py_library(
    name = "belt_library_lib",
    srcs = ["belt_library.py"],
)

py_library(
    name = "belt_drc_lib",
    srcs = ["belt_drc.py"],
    deps = [":belt_library_lib"],
)

py_binary(
    name = "belt_fuzzer",
    srcs = ["belt_fuzzer.py"],
    main = "belt_fuzzer.py",
    deps = [":pdk_lib"],
)

py_library(
    name = "pdk_lib",
    srcs = [
        "belt_drc.py",
        "belt_fuzzer.py",
        "belt_library.py",
        "blueprint.py",
        "bp2save.py",
        "circuit.py",
        "circuit_synth.py",
        "def2bp.py",
        "def_parser.py",
        "def_untangle.py",
        "entity_helpers.py",
        "jumper.py",
        "lef.py",
        "liberty.py",
        "netbuild.py",
        "netlist.py",
        "pdk.py",
        "pdn.py",
        "placement.py",
        "pump_insertion.py",
        "render_bp.py",
        "solve.py",
        "untangle/__init__.py",
        "untangle/channels.py",
        "untangle/jogs.py",
        "untangle/pins.py",
        "untangle/spatial.py",
    ],
    imports = ["."],
    deps = [
        "@pip//numpy",
        "@pip//pyslang",
        "@pip//scipy",
    ],
)

py_binary(
    name = "bp2save",
    srcs = ["bp2save.py"],
    main = "bp2save.py",
    deps = [":pdk_lib"],
)

py_binary(
    name = "def2bp",
    srcs = ["def2bp.py"],
    main = "def2bp.py",
    deps = [":pdk_lib"],
)

py_binary(
    name = "netbuild",
    srcs = ["netbuild.py"],
    main = "netbuild.py",
    deps = [":pdk_lib"],
)

py_binary(
    name = "solve",
    srcs = ["solve.py"],
    main = "solve.py",
    deps = [":pdk_lib"],
)

py_binary(
    name = "render_bp",
    srcs = ["render_bp.py"],
    data = ["//tools:render_blueprint.js"],
    main = "render_bp.py",
    deps = [":pdk_lib"],
)

py_test(
    name = "solve_test",
    size = "small",
    srcs = ["test_solve.py"],
    args = ["$(location //test:fixture)"],
    data = ["//test:fixture"],
    main = "test_solve.py",
    deps = [":pdk_lib"],
)

py_test(
    name = "pdk_smoke_test",
    size = "small",
    srcs = ["test_pdk.py"],
    args = ["$(location //test:fixture)"],
    data = ["//test:fixture"],
    main = "test_pdk.py",
    deps = [":pdk_lib"],
)

py_test(
    name = "netlist_test",
    size = "small",
    srcs = ["test_netlist.py"],
    args = ["$(location //test:fixture)"],
    data = ["//test:fixture"],
    main = "test_netlist.py",
    deps = [":pdk_lib"],
)

py_test(
    name = "lef_test",
    size = "small",
    srcs = ["test_lef.py"],
    args = ["$(location //test:fixture)"],
    data = ["//test:fixture"],
    main = "test_lef.py",
    deps = [":pdk_lib"],
)

py_test(
    name = "liberty_test",
    size = "small",
    srcs = ["test_liberty.py"],
    args = ["$(location //test:fixture)"],
    data = ["//test:fixture"],
    main = "test_liberty.py",
    deps = [":pdk_lib"],
)

py_test(
    name = "def2bp_test",
    size = "small",
    srcs = ["test_def2bp.py"],
    main = "test_def2bp.py",
    deps = [":pdk_lib"],
)

py_test(
    name = "bp2save_test",
    size = "small",
    srcs = ["test_bp2save.py"],
    main = "test_bp2save.py",
    deps = [":pdk_lib"],
)
