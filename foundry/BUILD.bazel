# Foundry PDK core. Synthesis (solver) in Python; place-and-route stays in
# OpenROAD. The reference/ scripts are prior art, not part of the build.
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# Python sources, for the workspace-wide lint and type checks.
filegroup(
    name = "py_srcs",
    srcs = glob(["*.py"]),
)

py_library(
    name = "pdk_lib",
    srcs = [
        "blueprint.py",
        "def2bp.py",
        "lef.py",
        "liberty.py",
        "netbuild.py",
        "netlist.py",
        "pdk.py",
        "solve.py",
    ],
    imports = ["."],
    deps = [
        "@pip//numpy",
        "@pip//pyslang",
        "@pip//scipy",
    ],
)

py_binary(
    name = "def2bp",
    srcs = ["def2bp.py"],
    main = "def2bp.py",
    deps = [":pdk_lib"],
)

py_binary(
    name = "netbuild",
    srcs = ["netbuild.py"],
    main = "netbuild.py",
    deps = [":pdk_lib"],
)

py_binary(
    name = "solve",
    srcs = ["solve.py"],
    main = "solve.py",
    deps = [":pdk_lib"],
)

py_test(
    name = "solve_test",
    size = "small",
    srcs = ["test_solve.py"],
    args = ["$(location //test:fixture)"],
    data = ["//test:fixture"],
    main = "test_solve.py",
    deps = [":pdk_lib"],
)

py_test(
    name = "pdk_smoke_test",
    size = "small",
    srcs = ["test_pdk.py"],
    args = ["$(location //test:fixture)"],
    data = ["//test:fixture"],
    main = "test_pdk.py",
    deps = [":pdk_lib"],
)

py_test(
    name = "netlist_test",
    size = "small",
    srcs = ["test_netlist.py"],
    args = ["$(location //test:fixture)"],
    data = ["//test:fixture"],
    main = "test_netlist.py",
    deps = [":pdk_lib"],
)

py_test(
    name = "lef_test",
    size = "small",
    srcs = ["test_lef.py"],
    args = ["$(location //test:fixture)"],
    data = ["//test:fixture"],
    main = "test_lef.py",
    deps = [":pdk_lib"],
)

py_test(
    name = "liberty_test",
    size = "small",
    srcs = ["test_liberty.py"],
    args = ["$(location //test:fixture)"],
    data = ["//test:fixture"],
    main = "test_liberty.py",
    deps = [":pdk_lib"],
)

py_test(
    name = "def2bp_test",
    size = "small",
    srcs = ["test_def2bp.py"],
    data = [
        "factory.def",
        "netlist.json",
    ],
    main = "test_def2bp.py",
    deps = [":pdk_lib"],
)
