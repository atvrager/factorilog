# Common configuration
common --enable_bzlmod=true

# Build options
build --verbose_failures
build --action_env=DISPLAY
build --action_env=FACTORIO_BIN
build --action_env=FIREFOX_BIN
build --action_env=LIBGL_ALWAYS_SOFTWARE

# Test options
test --test_output=errors
test --test_env=FACTORIO_BIN
test --test_env=PATH
